# Dependencies
node_modules/

# Build output
dist/
dist-server/
target/

# Environment and secrets — never commit real credentials
.env
.env.local
.env.*.local

# TrueForge local runtime state (SQLite, sessions)
.trueforge/
trueforge-data/

