# ASTrix agent-runtime configuration — placeholder values only.
# Copy to `.env` (git-ignored) and fill in real credentials there.
# NEVER commit real keys, and NEVER expose these variables to browser code.

# NVIDIA NIM OpenAI-compatible endpoint (shared by both credentials)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Credential A — models: meta/muse-glimmer-30b,
# nvidia/nemotron-3.5-lightning-30b-a3b, poolside/laguna-xs-2.1,
# nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_API_KEY_A=nvapi-REPLACE_WITH_KEY_A

# Credential B — models: z-ai/glm-5.3, z-ai/glm-5.3-flash,
# nvidia/nemotron-3-nano-omni-30b-a3b-reasoning, google/gemma-4-31b-it,
# nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_API_KEY_B=nvapi-REPLACE_WITH_KEY_B

# Model selection (must be IDs from the registry in
# src/agent/nvidia/ModelRegistry.ts). Evaluated 2026-10-09: primary
# nvidia/nemotron-3-super-120b-a12b (4/4 legal, 3-9s, valid via TrueForge);
# z-ai/glm-5.3-flash scored 4/4 but at ~150s/turn suits offline review only.
ASTRIX_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b
ASTRIX_SECONDARY_MODEL=z-ai/glm-5.3-flash

# New replaceable inference providers (server-side only — never expose these
# to browser code, logs, or committed files).
# Gemini key (AI Studio). Tiny test calls verified 2026-10-10 on
# gemini-3.5-flash-lite; no cost field is returned, so free-tier status at
# scale must be verified against billing before heavy use.
GEMINI_API_KEY=
# OpenRouter key. Free-tier models verified 2026-10-10 (usage.cost == 0);
# shared-pool free models may 429 upstream under load.
OPENROUTER_API_KEY=
# Active provider/model for game decisions. Providers: gemini | openrouter | nim
ASTRIX_AI_PROVIDER=gemini
ASTRIX_AI_MODEL=gemini-3.5-flash-lite
# Optional explicit fallback order (comma-separated). No silent swapping:
# every failed provider is recorded; fallback engages only if configured.
ASTRIX_AI_FALLBACK=openrouter
# Optional per-provider model override used only when that provider is tried
# via fallback (primary model comes from ASTRIX_AI_MODEL).
ASTRIX_AI_MODEL_GEMINI=gemini-3.5-flash-lite
ASTRIX_AI_MODEL_OPENROUTER=nvidia/nemotron-3-super-120b-a12b:free

# TrueForge server (local harness runtime). When reachable, the agent loop
# runs through TrueForge sessions/turns; otherwise the server reports
# `trueforge-unavailable` and model turns are served direct-to-NIM with that
# limitation explicitly labelled.
TRUEFORGE_BASE_URL=http://localhost:8790

# Live-chain integration tests stay OFF unless explicitly enabled with a
# funded devnet wallet. Never enable in CI.
ASTRIX_LIVE_DEVNET=
